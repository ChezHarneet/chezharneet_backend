# PostgreSQL connection string; use a dedicated non-superuser application role.
DATABASE_URL="postgresql://tcf_user:ChangeThis_ToAStrongPassword123!@localhost:5432/tcf_canada?schema=public"

# Generate a long random secret locally. Never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret"

# API
PORT=4000
# WEB_URL is also added to the explicit CORS allowlist. Keep these as exact origins.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
WEB_URL="https://YOUR-FRONTEND-NGROK-URL"
# OAuth callbacks reach the local API through the frontend's /api rewrite.
API_PUBLIC_URL="https://YOUR-FRONTEND-NGROK-URL/api"

# Optional notification worker dependencies used by the existing backend.
REDIS_URL="redis://localhost:6379"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Payment provider integration is not enabled in this starter yet.
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
